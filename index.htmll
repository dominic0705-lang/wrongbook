<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>全能國中線上錯題本</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <!-- html2canvas for exporting single question as image -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        :root {
            /* Default Theme: 3. 淺藍天空 (Sky Blue - High Readability) */
            --bg-primary: #f0f7ff;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e0effe;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --accent-primary: #0284c7;
            --accent-hover: #0369a1;
            --accent-light: #e0f2fe;
            --border-color: #bae6fd;
            --card-shadow: 0 4px 20px -2px rgba(2, 132, 199, 0.08);
            --danger-color: #e11d48;
            --success-color: #16a34a;
            --warning-color: #d97706;
        }

        [data-theme="dark-eye"] {
            /* Theme 1: 深色護眼 (Dark Eye-Care - Warm Slate & Soft Amber/Green) */
            --bg-primary: #181a1b;
            --bg-secondary: #222527;
            --bg-tertiary: #2c3033;
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --accent-primary: #10b981;
            --accent-hover: #059669;
            --accent-light: rgba(16, 185, 129, 0.15);
            --border-color: #374151;
            --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
            --danger-color: #f43f5e;
            --success-color: #34d399;
            --warning-color: #fbbf24;
        }

        [data-theme="cyberpunk"] {
            /* Theme 2: 賽博龐克 (Cyberpunk - High Contrast Readability First) */
            --bg-primary: #0b0c10;
            --bg-secondary: #141622;
            --bg-tertiary: #1f2235;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-primary: #00f0ff;
            --accent-hover: #00bcd4;
            --accent-light: rgba(0, 240, 255, 0.12);
            --border-color: #bc13fe;
            --card-shadow: 0 0 15px rgba(188, 19, 254, 0.25);
            --danger-color: #ff0055;
            --success-color: #00ff9d;
            --warning-color: #fcee09;
        }

        body {
            font-family: 'Noto Sans TC', 'Inter', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.25s ease, color 0.25s ease;
            overflow-x: hidden;
        }

        .theme-card {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            box-shadow: var(--card-shadow);
            color: var(--text-primary);
        }

        .theme-input {
            background-color: var(--bg-primary);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }
        .theme-input:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 2px var(--accent-light);
        }

        .theme-btn-primary {
            background-color: var(--accent-primary);
            color: #ffffff;
        }
        [data-theme="cyberpunk"] .theme-btn-primary {
            color: #090a0f;
            font-weight: 700;
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
        }
        .theme-btn-primary:hover {
            background-color: var(--accent-hover);
        }

        .theme-btn-secondary {
            background-color: var(--bg-tertiary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }
        .theme-btn-secondary:hover {
            border-color: var(--accent-primary);
        }

        .theme-badge {
            background-color: var(--accent-light);
            color: var(--accent-primary);
            border: 1px solid var(--border-color);
        }

        /* Viewport simulation mode for Mobile vs Desktop */
        .viewport-mobile-frame {
            max-width: 430px !important;
            margin: 0 auto !important;
            border-left: 3px solid var(--border-color);
            border-right: 3px solid var(--border-color);
            min-height: 100vh;
            box-shadow: 0 0 40px rgba(0,0,0,0.3);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-primary);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        /* Print Media Styles: One question per page/image */
        @media print {
            @page {
                size: A4 portrait;
                margin: 12mm;
            }
            body {
                background: #ffffff !important;
                color: #000000 !important;
            }
            #app-wrapper, #question-modal, #settings-modal, #trash-modal, #print-preview-modal, #toast-box {
                display: none !important;
            }
            #print-staging-area {
                display: block !important;
                position: static !important;
                width: 100% !important;
                background: #ffffff !important;
                color: #000000 !important;
            }
            .print-page-card {
                page-break-after: always;
                break-after: page;
                page-break-inside: avoid;
                break-inside: avoid;
                border: 2px solid #1e293b !important;
                border-radius: 12px !important;
                padding: 24px !important;
                margin-bottom: 0 !important;
                background: #ffffff !important;
                color: #0f172a !important;
                box-shadow: none !important;
                box-sizing: border-box;
            }
            .print-page-card:last-child {
                page-break-after: auto;
                break-after: auto;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <div id="app-wrapper" class="w-full flex-1 flex flex-col transition-all duration-300">
        
        <!-- Top Navigation Bar -->
        <header class="theme-card sticky top-0 z-30 px-4 py-3 border-b">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
                <!-- Brand Title -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center theme-btn-primary text-lg font-bold shadow-sm">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold tracking-tight flex items-center gap-2">
                            全能國中錯題本
                            <span id="device-mode-indicator" class="text-xs px-2 py-0.5 rounded-full theme-badge font-normal">自動響應</span>
                        </h1>
                        <p class="text-xs" style="color: var(--text-secondary);">AI 智慧掃描 · 幾何手繪標記 · 單題圖卡列印</p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="openModal('question-modal')" class="theme-btn-primary px-3.5 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition shadow-sm">
                        <i class="fa-solid fa-plus"></i>
                        <span>新增錯題</span>
                    </button>
                    <!-- Quick Direct Image Upload Button on Header -->
                    <label class="theme-btn-secondary px-3.5 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition cursor-pointer border-2" style="border-color: var(--accent-primary);">
                        <i class="fa-solid fa-cloud-arrow-up" style="color: var(--accent-primary);"></i>
                        <span>上傳題目照片</span>
                        <input type="file" accept="image/*" class="hidden" onchange="quickHeaderImageUpload(event)">
                    </label>
                    <button onclick="togglePrintSelectionMode()" id="btn-print-mode" class="theme-btn-secondary px-3.5 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-print"></i>
                        <span>選題列印 / 轉圖</span>
                    </button>
                    <!-- Trash Bin Button -->
                    <button onclick="openTrashModal()" class="theme-btn-secondary px-3 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition relative" title="查看已刪除的錯題回收站">
                        <i class="fa-solid fa-trash-can-arrow-up text-rose-500"></i>
                        <span class="hidden sm:inline">垃圾桶</span>
                        <span id="trash-count-badge" class="px-1.5 py-0.2 rounded-full text-[11px] bg-rose-500 text-white font-mono">0</span>
                    </button>
                    <!-- Backup Import / Export -->
                    <label class="theme-btn-secondary px-3 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition cursor-pointer" title="匯入先前備份的錯題檔 (.json)">
                        <i class="fa-solid fa-file-import"></i>
                        <span class="hidden sm:inline">匯入</span>
                        <input type="file" accept=".json" class="hidden" onchange="importQuestionsJson(event)">
                    </label>
                    <button onclick="exportQuestionsJson()" class="theme-btn-secondary px-3 py-2 rounded-xl text-sm font-medium flex items-center gap-1.5 transition" title="將目前錯題匯出成備份檔">
                        <i class="fa-solid fa-file-export"></i>
                        <span class="hidden sm:inline">備份</span>
                    </button>
                    <button onclick="openModal('settings-modal')" class="theme-btn-secondary p-2.5 rounded-xl text-sm transition" title="外觀與版面設定">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Print Selection Bar (Hidden by default) -->
        <div id="print-action-bar" class="hidden bg-amber-500/15 border-b border-amber-500/40 px-4 py-3 sticky top-[65px] z-20 backdrop-blur-md">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="font-bold text-sm flex items-center gap-2">
                        <i class="fa-solid fa-check-double text-amber-500"></i>
                        已勾選 <span id="selected-count" class="underline font-mono text-base">0</span> 題準備輸出
                    </span>
                    <button onclick="selectAllVisibleQuestions()" class="text-xs px-2.5 py-1 rounded-lg theme-btn-secondary">全選目前篩選</button>
                    <button onclick="clearSelectedQuestions()" class="text-xs px-2.5 py-1 rounded-lg theme-btn-secondary">清除選擇</button>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="openPrintPreviewModal()" class="theme-btn-primary px-4 py-1.5 rounded-xl text-sm font-bold flex items-center gap-1.5 shadow">
                        <i class="fa-solid fa-print"></i> 預覽與一題一頁列印
                    </button>
                    <button onclick="exportSelectedAsImages()" class="theme-btn-secondary px-4 py-1.5 rounded-xl text-sm font-medium flex items-center gap-1.5">
                        <i class="fa-solid fa-images"></i> 批次轉成單題高清圖卡
                    </button>
                    <button onclick="togglePrintSelectionMode()" class="text-xs px-2.5 py-1.5 rounded-lg hover:opacity-80">結束選題</button>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <main class="max-w-7xl w-full mx-auto px-4 py-5 flex-1 flex flex-col gap-5">
            
            <!-- Filter & Search Panel -->
            <section class="theme-card rounded-2xl p-4">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                    <!-- Keyword Search -->
                    <div class="md:col-span-4 relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-sm" style="color: var(--text-secondary);"></i>
                        <input type="text" id="filter-search" oninput="renderQuestions()" placeholder="搜尋題目內容、解析或標籤..." class="theme-input w-full pl-9 pr-3 py-2 rounded-xl text-sm">
                    </div>

                    <!-- Subject Filter -->
                    <div class="md:col-span-2">
                        <select id="filter-subject" onchange="renderQuestions()" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                            <option value="ALL">📚 全部國中科目</option>
                            <option value="國文">國文</option>
                            <option value="英文">英文</option>
                            <option value="數學">數學</option>
                            <option value="理化">自然 - 理化</option>
                            <option value="生物">自然 - 生物</option>
                            <option value="地科">自然 - 地球科學</option>
                            <option value="歷史">社會 - 歷史</option>
                            <option value="地理">社會 - 地理</option>
                            <option value="公民">社會 - 公民</option>
                        </select>
                    </div>

                    <!-- Error Reason Filter -->
                    <div class="md:col-span-2">
                        <select id="filter-reason" onchange="renderQuestions()" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                            <option value="ALL">🔍 全部錯誤原因</option>
                            <option value="觀念不清">觀念不清</option>
                            <option value="粗心看錯">粗心看錯</option>
                            <option value="計算錯誤">計算錯誤</option>
                            <option value="公式忘記">公式/單字忘記</option>
                            <option value="圖形誤判">幾何/圖表誤判</option>
                            <option value="時間不夠">時間不夠</option>
                        </select>
                    </div>

                    <!-- Difficulty / Importance Sort -->
                    <div class="md:col-span-2">
                        <select id="filter-sort" onchange="renderQuestions()" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                            <option value="date-desc">📅 日期：最新優先</option>
                            <option value="importance-desc">🔥 重要度：最高優先</option>
                            <option value="difficulty-desc">⚡ 難度：最難優先</option>
                        </select>
                    </div>

                    <!-- Review Mode Toggle (Hide/Show Answers) -->
                    <div class="md:col-span-2 flex justify-end">
                        <button onclick="toggleBlindReviewMode()" id="btn-blind-review" class="w-full theme-btn-secondary px-3 py-2 rounded-xl text-sm font-medium flex items-center justify-center gap-1.5 transition">
                            <i class="fa-solid fa-eye-slash"></i>
                            <span>遮蔽答案自測</span>
                        </button>
                    </div>
                </div>

                <!-- Quick Subject Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto pt-3 mt-3 border-t" style="border-color: var(--border-color);" id="subject-quick-pills">
                    <!-- Populated dynamically by JS -->
                </div>
            </section>

            <!-- Questions Grid -->
            <section id="questions-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Populated by JavaScript -->
            </section>
        </main>
    </div>

    <!-- Modal: Add / Edit Question -->
    <div id="question-modal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4">
        <div class="theme-card w-full max-w-4xl rounded-2xl overflow-hidden flex flex-col max-h-[90vh] shadow-2xl border-2" style="border-color: var(--accent-primary);">
            <!-- Modal Header (Sticky Top with Instant Confirm Button) -->
            <div class="px-4 sm:px-5 py-3.5 border-b flex flex-wrap items-center justify-between gap-2 shrink-0" style="border-color: var(--border-color); background-color: var(--bg-secondary);">
                <h2 id="modal-title" class="text-base sm:text-lg font-bold flex items-center gap-2">
                    <i class="fa-solid fa-file-circle-plus" style="color: var(--accent-primary);"></i>
                    <span>新增國中錯題記錄</span>
                </h2>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="saveQuestion()" class="theme-btn-primary px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-md hover:scale-105 transition">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>確認儲存</span>
                    </button>
                    <button type="button" onclick="closeModal('question-modal')" class="w-9 h-9 rounded-xl theme-btn-secondary flex items-center justify-center text-base" title="關閉視窗">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="p-4 sm:p-5 overflow-y-auto space-y-5 flex-1 min-h-0">
                <input type="hidden" id="edit-question-id">

                <!-- Row 1: Subject, Date, Error Reason -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">科目分類 *</label>
                        <select id="q-subject" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                            <option value="數學">📐 數學</option>
                            <option value="理化">🧪 自然 - 理化</option>
                            <option value="生物">🧬 自然 - 生物</option>
                            <option value="地科">🌍 自然 - 地球科學</option>
                            <option value="國文">📖 國文</option>
                            <option value="英文">🔤 英文</option>
                            <option value="歷史">🏛️ 社會 - 歷史</option>
                            <option value="地理">🗺️ 社會 - 地理</option>
                            <option value="公民">⚖️ 社會 - 公民</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">錯誤原因 *</label>
                        <select id="q-reason" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                            <option value="觀念不清">觀念不清</option>
                            <option value="粗心看錯">粗心看錯</option>
                            <option value="計算錯誤">計算錯誤</option>
                            <option value="公式忘記">公式/單字忘記</option>
                            <option value="圖形誤判">幾何/圖表誤判</option>
                            <option value="時間不夠">時間不夠</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">記錄日期 *</label>
                        <input type="date" id="q-date" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                    </div>
                </div>

                <!-- Row 2: Tags, Difficulty, Importance -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">章節與自訂標籤 (以逗號分隔)</label>
                        <input type="text" id="q-tags" placeholder="例：畢氏定理, 二次函數, 段考題" class="theme-input w-full px-3 py-2 rounded-xl text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">難度評估 (1~5顆星)</label>
                        <div class="flex items-center gap-2 h-9 px-3 rounded-xl theme-input" id="difficulty-stars-picker">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1.5">重要度 (1~5顆星)</label>
                        <div class="flex items-center gap-2 h-9 px-3 rounded-xl theme-input" id="importance-stars-picker">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>

                <!-- Math & Geometry Symbol Palette -->
                <div class="p-3 rounded-xl border" style="background-color: var(--bg-tertiary); border-color: var(--border-color);">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-square-root-variable" style="color: var(--accent-primary);"></i>
                            國中常用數學與幾何符號快捷鍵（點擊直接插入至游標處）
                        </span>
                        <span class="text-[11px]" style="color: var(--text-secondary);">支援題目與解析欄</span>
                    </div>
                    <div class="flex flex-wrap gap-1.5" id="math-symbol-buttons">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- AI Image OCR Scanner Bar -->
                <div class="p-3.5 rounded-xl border flex flex-wrap items-center justify-between gap-3" style="background-color: var(--accent-light); border-color: var(--accent-primary);">
                    <div class="flex items-center gap-2.5">
                        <i class="fa-solid fa-wand-magic-sparkles text-lg" style="color: var(--accent-primary);"></i>
                        <div>
                            <div class="text-xs font-bold">AI 智慧圖片掃描轉文字 (OCR)</div>
                            <div class="text-[11px]" style="color: var(--text-secondary);">拍下考卷或講義照片，自動辨識題目與數學符號並貼上！</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="theme-btn-primary px-3 py-1.5 rounded-xl text-xs font-medium cursor-pointer flex items-center gap-1.5">
                            <i class="fa-solid fa-camera"></i>
                            <span>選擇圖片掃描至題目</span>
                            <input type="file" accept="image/*" class="hidden" onchange="scanImageToText(event, 'q-content')">
                        </label>
                        <label class="theme-btn-secondary px-3 py-1.5 rounded-xl text-xs font-medium cursor-pointer flex items-center gap-1.5">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>掃描至詳解</span>
                            <input type="file" accept="image/*" class="hidden" onchange="scanImageToText(event, 'q-answer')">
                        </label>
                    </div>
                </div>

                <!-- OCR Loading Status -->
                <div id="ocr-status-banner" class="hidden p-3 rounded-xl bg-amber-500/20 border border-amber-500 text-xs font-medium flex items-center gap-2">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span id="ocr-status-text">正在使用 AI 辨識圖片中的文字與數學符號，請稍候...</span>
                </div>

                <!-- Question Text -->
                <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                        <label class="block text-xs font-semibold">題目內容 *</label>
                        <div class="flex items-center gap-1.5">
                            <label class="theme-btn-primary px-2.5 py-1 rounded-lg text-xs font-medium cursor-pointer flex items-center gap-1 shadow-sm">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span>上傳題目照片 (AI自動轉文字+附圖)</span>
                                <input type="file" accept="image/*" class="hidden" onchange="scanImageToText(event, 'q-content')">
                            </label>
                            <label class="theme-btn-secondary px-2.5 py-1 rounded-lg text-xs font-medium cursor-pointer flex items-center gap-1">
                                <i class="fa-solid fa-image"></i>
                                <span>僅上傳圖片至畫板</span>
                                <input type="file" accept="image/*" class="hidden" onchange="loadBackgroundImageToCanvas(event)">
                            </label>
                        </div>
                    </div>
                    <textarea id="q-content" rows="3" onfocus="setLastFocusedInput('q-content')" placeholder="直接輸入題目文字，或點擊右上角「上傳題目照片」自動辨識填入..." class="theme-input w-full p-3 rounded-xl text-sm leading-relaxed"></textarea>
                </div>

                <!-- Correct Answer & Solution Process -->
                <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                        <label class="block text-xs font-semibold">正確答案與解題過程 (可填文字或於下方上傳圖片)</label>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <label class="theme-btn-primary px-2.5 py-1 rounded-lg text-xs font-medium cursor-pointer flex items-center gap-1 shadow-sm">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span>上傳詳解照片 (AI自動轉文字+標記)</span>
                                <input type="file" accept="image/*" class="hidden" onchange="scanImageToText(event, 'q-answer')">
                            </label>
                            <label class="theme-btn-secondary px-2.5 py-1 rounded-lg text-xs font-medium cursor-pointer flex items-center gap-1">
                                <i class="fa-solid fa-highlighter"></i>
                                <span>上傳手寫算式照做標記</span>
                                <input type="file" accept="image/*" class="hidden" onchange="loadBackgroundImageToCanvas(event)">
                            </label>
                        </div>
                    </div>
                    <textarea id="q-answer" rows="4" onfocus="setLastFocusedInput('q-answer')" placeholder="寫下詳細推導過程、正確答案，或點擊右上角「上傳詳解照片」..." class="theme-input w-full p-3 rounded-xl text-sm leading-relaxed"></textarea>
                    
                    <!-- Mid-form Quick Confirm Bar right after filling text -->
                    <div class="mt-2.5 flex items-center justify-end gap-2">
                        <span class="text-xs" style="color: var(--text-secondary);">文字填寫完畢？可直接點擊確認，或繼續往下畫圖標記：</span>
                        <button type="button" onclick="saveQuestion()" class="theme-btn-primary px-4 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-check-double"></i>
                            <span>完成並確認儲存</span>
                        </button>
                    </div>
                </div>

                <!-- Interactive Drawing / Photo Annotation / Geometry Tool -->
                <div id="canvas-section-box" class="border rounded-2xl p-4 space-y-3" style="border-color: var(--border-color); background-color: var(--bg-primary);">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="text-sm font-bold flex items-center gap-2">
                                <i class="fa-solid fa-pen-ruler" style="color: var(--accent-primary);"></i>
                                <span>題目附圖 / 幾何圖形與手寫標記畫板</span>
                            </h3>
                            <p class="text-xs" style="color: var(--text-secondary);">可上傳考卷照片在上面用紅筆圈選重點，或直接繪製幾何圖形與輔助線</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <label class="theme-btn-primary px-3 py-1.5 rounded-xl text-xs font-medium cursor-pointer flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-upload"></i>
                                <span>上傳照片至畫板標記</span>
                                <input type="file" accept="image/*" class="hidden" onchange="loadBackgroundImageToCanvas(event)">
                            </label>
                            <button type="button" onclick="clearCanvas()" class="theme-btn-secondary px-3 py-1.5 rounded-xl text-xs font-medium text-rose-500">
                                <i class="fa-solid fa-trash-can"></i> 清空畫板
                            </button>
                        </div>
                    </div>

                    <!-- Drawing Toolbar -->
                    <div class="flex flex-wrap items-center gap-2 p-2 rounded-xl theme-card">
                        <div class="flex items-center gap-1 border-r pr-2" style="border-color: var(--border-color);">
                            <button type="button" onclick="setCanvasTool('pen')" id="tool-pen" class="canvas-tool-btn theme-btn-primary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="畫筆">
                                <i class="fa-solid fa-pen"></i> 畫筆
                            </button>
                            <button type="button" onclick="setCanvasTool('highlighter')" id="tool-highlighter" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="螢光筆標記">
                                <i class="fa-solid fa-highlighter"></i> 螢光筆
                            </button>
                            <button type="button" onclick="setCanvasTool('line')" id="tool-line" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="直線/輔助線">
                                <i class="fa-solid fa-slash"></i> 直線
                            </button>
                            <button type="button" onclick="setCanvasTool('triangle')" id="tool-triangle" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="直角三角形">
                                <i class="fa-solid fa-play fa-rotate-270"></i> 三角形
                            </button>
                            <button type="button" onclick="setCanvasTool('rect')" id="tool-rect" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="矩形">
                                <i class="fa-regular fa-square"></i> 矩形
                            </button>
                            <button type="button" onclick="setCanvasTool('circle')" id="tool-circle" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="圓形">
                                <i class="fa-regular fa-circle"></i> 圓形
                            </button>
                            <button type="button" onclick="setCanvasTool('axes')" id="tool-axes" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="直角坐標軸">
                                <i class="fa-solid fa-arrows-up-down-left-right"></i> 坐標軸
                            </button>
                            <button type="button" onclick="setCanvasTool('eraser')" id="tool-eraser" class="canvas-tool-btn theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="橡皮擦">
                                <i class="fa-solid fa-eraser"></i> 橡皮擦
                            </button>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button type="button" onclick="setCanvasColor('#ef4444')" class="w-5 h-5 rounded-full bg-red-500 border-2 border-white shadow" title="紅筆"></button>
                            <button type="button" onclick="setCanvasColor('#2563eb')" class="w-5 h-5 rounded-full bg-blue-600 border-2 border-white shadow" title="藍筆"></button>
                            <button type="button" onclick="setCanvasColor('#16a34a')" class="w-5 h-5 rounded-full bg-green-600 border-2 border-white shadow" title="綠筆"></button>
                            <button type="button" onclick="setCanvasColor('#0f172a')" class="w-5 h-5 rounded-full bg-slate-900 border-2 border-white shadow" title="黑筆"></button>
                            <button type="button" onclick="undoCanvasStroke()" class="theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs ml-2 flex items-center gap-1">
                                <i class="fa-solid fa-rotate-left"></i> 上一步
                            </button>
                        </div>
                    </div>

                    <!-- Canvas Element Container -->
                    <div class="flex justify-center bg-white rounded-xl overflow-hidden border shadow-inner" style="border-color: var(--border-color); touch-action: none;">
                        <canvas id="annotation-canvas" width="650" height="280" class="w-full max-w-full h-auto cursor-crosshair bg-white"></canvas>
                    </div>
                </div>
            </div>

            <!-- Modal Footer (Fixed Confirm Button) -->
            <div class="px-5 py-3.5 border-t flex items-center justify-between shrink-0" style="border-color: var(--border-color); background-color: var(--bg-tertiary);">
                <span class="text-xs" style="color: var(--text-secondary);">提示：填寫完資料或畫完圖後，點擊右側按鈕直接儲存</span>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeModal('question-modal')" class="theme-btn-secondary px-4 py-2 rounded-xl text-sm font-medium">取消</button>
                    <button type="button" onclick="saveQuestion()" class="theme-btn-primary px-6 py-2 rounded-xl text-sm font-bold shadow-md hover:scale-105 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-check-double"></i>
                        <span>確認並儲存錯題</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Settings (Theme & Layout & Custom API Key) -->
    <div id="settings-modal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="theme-card w-full max-w-lg rounded-2xl overflow-hidden flex flex-col shadow-2xl border-2" style="border-color: var(--accent-primary);">
            <div class="px-5 py-4 border-b flex items-center justify-between" style="border-color: var(--border-color);">
                <h2 class="text-base font-bold flex items-center gap-2">
                    <i class="fa-solid fa-gear" style="color: var(--accent-primary);"></i>
                    <span>外觀與進階設定</span>
                </h2>
                <button onclick="closeModal('settings-modal')" class="w-8 h-8 rounded-lg theme-btn-secondary flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="p-5 space-y-6 overflow-y-auto">
                <!-- Theme Selection -->
                <div>
                    <label class="block text-sm font-bold mb-2.5">🎨 選擇高可讀性主題風格</label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <button onclick="setTheme('sky-blue')" id="theme-btn-sky-blue" class="theme-btn-secondary p-3 rounded-xl text-xs font-medium flex flex-col items-center gap-2 transition relative border-2">
                            <div class="w-full h-8 rounded-lg bg-[#f0f7ff] border border-[#0284c7] flex items-center justify-center text-[#0284c7] font-bold">淺藍天空</div>
                            <span>3. 淺藍天空 (預設)</span>
                            <i class="fa-solid fa-circle-check absolute top-2 right-2 text-sky-600 theme-check"></i>
                        </button>
                        <button onclick="setTheme('dark-eye')" id="theme-btn-dark-eye" class="theme-btn-secondary p-3 rounded-xl text-xs font-medium flex flex-col items-center gap-2 transition relative border-2">
                            <div class="w-full h-8 rounded-lg bg-[#181a1b] border border-[#10b981] flex items-center justify-center text-[#10b981] font-bold">深色護眼</div>
                            <span>1. 深色護眼模式</span>
                            <i class="fa-solid fa-circle-check absolute top-2 right-2 text-emerald-400 theme-check hidden"></i>
                        </button>
                        <button onclick="setTheme('cyberpunk')" id="theme-btn-cyberpunk" class="theme-btn-secondary p-3 rounded-xl text-xs font-medium flex flex-col items-center gap-2 transition relative border-2">
                            <div class="w-full h-8 rounded-lg bg-[#0b0c10] border border-[#00f0ff] flex items-center justify-center text-[#00f0ff] font-bold">賽博龐克</div>
                            <span>2. 賽博龐克風格</span>
                            <i class="fa-solid fa-circle-check absolute top-2 right-2 text-cyan-400 theme-check hidden"></i>
                        </button>
                    </div>
                </div>

                <!-- Device Layout Mode -->
                <div>
                    <label class="block text-sm font-bold mb-2.5">📱 電腦 / 手機版面切換</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="setDeviceLayout('auto')" id="layout-btn-auto" class="theme-btn-secondary py-2.5 px-3 rounded-xl text-xs font-medium flex flex-col items-center gap-1.5">
                            <i class="fa-solid fa-laptop-mobile text-base"></i>
                            <span>自動適應</span>
                        </button>
                        <button onclick="setDeviceLayout('desktop')" id="layout-btn-desktop" class="theme-btn-secondary py-2.5 px-3 rounded-xl text-xs font-medium flex flex-col items-center gap-1.5">
                            <i class="fa-solid fa-desktop text-base"></i>
                            <span>強制電腦寬版</span>
                        </button>
                        <button onclick="setDeviceLayout('mobile')" id="layout-btn-mobile" class="theme-btn-secondary py-2.5 px-3 rounded-xl text-xs font-medium flex flex-col items-center gap-1.5">
                            <i class="fa-solid fa-mobile-screen-button text-base"></i>
                            <span>模擬手機單欄</span>
                        </button>
                    </div>
                </div>

                <!-- Optional Custom Gemini API Key for Offline / Local HTML Usage -->
                <div class="pt-3 border-t" style="border-color: var(--border-color);">
                    <label class="block text-xs font-bold mb-1">🔑 外部環境自訂 Gemini API Key（選填）</label>
                    <p class="text-[11px] mb-2" style="color: var(--text-secondary);">在 Canvas 內可直接使用免填；若將網頁下載到自己電腦或手機使用 AI 掃描，可貼上您申請的免費金鑰。</p>
                    <input type="password" id="custom-api-key-input" onchange="saveCustomApiKey(this.value)" placeholder="AIzaSy... (留空則使用系統預設)" class="theme-input w-full px-3 py-2 rounded-xl text-xs font-mono">
                </div>
            </div>

            <div class="px-5 py-3.5 border-t flex justify-end" style="border-color: var(--border-color);">
                <button onclick="closeModal('settings-modal')" class="theme-btn-primary px-5 py-2 rounded-xl text-sm font-medium">完成設定</button>
            </div>
        </div>
    </div>

    <!-- Modal: Trash Bin (Recently Deleted Questions) -->
    <div id="trash-modal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4">
        <div class="theme-card w-full max-w-3xl rounded-2xl overflow-hidden flex flex-col max-h-[85vh] shadow-2xl border-2 border-rose-500/50">
            <div class="px-5 py-4 border-b flex flex-wrap items-center justify-between gap-2 shrink-0" style="border-color: var(--border-color);">
                <div>
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <i class="fa-solid fa-trash-can-arrow-up text-rose-500"></i>
                        <span>錯題垃圾桶（回收站）</span>
                    </h2>
                    <p class="text-xs" style="color: var(--text-secondary);">誤刪的錯題會保存在這裡，您可以隨時還原至錯題本或永久刪除</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="restoreAllFromTrash()" id="btn-restore-all" class="theme-btn-secondary px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1 text-emerald-500">
                        <i class="fa-solid fa-rotate-left"></i> 全部還原
                    </button>
                    <button onclick="emptyTrashBin()" id="btn-empty-trash" class="theme-btn-secondary px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1 text-rose-500">
                        <i class="fa-solid fa-fire-burner"></i> 清空垃圾桶
                    </button>
                    <button onclick="closeModal('trash-modal')" class="w-8 h-8 rounded-lg theme-btn-secondary flex items-center justify-center">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <div id="trash-list-container" class="p-5 overflow-y-auto space-y-3 flex-1 min-h-0">
                <!-- Populated dynamically by JS -->
            </div>

            <div class="px-5 py-3 border-t flex justify-end shrink-0" style="border-color: var(--border-color); background-color: var(--bg-tertiary);">
                <button onclick="closeModal('trash-modal')" class="theme-btn-primary px-5 py-2 rounded-xl text-sm font-medium">關閉視窗</button>
            </div>
        </div>
    </div>

    <!-- Modal: Enhanced Print Preview & Export Options -->
    <div id="print-preview-modal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4">
        <div class="theme-card w-full max-w-4xl rounded-2xl overflow-hidden flex flex-col max-h-[90vh] shadow-2xl border-2" style="border-color: var(--accent-primary);">
            <!-- Header -->
            <div class="px-5 py-3.5 border-b flex flex-wrap items-center justify-between gap-3 shrink-0" style="border-color: var(--border-color);">
                <div>
                    <h2 class="text-base sm:text-lg font-bold flex items-center gap-2">
                        <i class="fa-solid fa-print" style="color: var(--accent-primary);"></i>
                        <span>選題列印與單題圖卡預覽（共 <span id="preview-total-count">0</span> 題）</span>
                    </h2>
                    <p class="text-xs" style="color: var(--text-secondary);">每一題將獨立排成一頁或一張高清圖片，絕不跨頁截斷</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="triggerBrowserPrint()" class="theme-btn-primary px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-print"></i> 立即啟動印表機 / 存成 PDF
                    </button>
                    <button onclick="exportPreviewCardsAsImages()" class="theme-btn-secondary px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-1.5">
                        <i class="fa-solid fa-images"></i> 逐題下載為 PNG 圖片
                    </button>
                    <button onclick="closeModal('print-preview-modal')" class="w-8 h-8 rounded-lg theme-btn-secondary flex items-center justify-center">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Print Customization Toolbar -->
            <div class="px-5 py-3 border-b flex flex-wrap items-center justify-between gap-4 text-xs shrink-0" style="background-color: var(--bg-tertiary); border-color: var(--border-color);">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <span class="font-bold">📄 輸出模式：</span>
                        <label class="flex items-center gap-1 cursor-pointer">
                            <input type="radio" name="print-mode-option" value="study" checked onchange="renderPrintPreviewCards()" class="accent-sky-600">
                            <span>完整詳解版（含答案與過程）</span>
                        </label>
                        <label class="flex items-center gap-1 cursor-pointer ml-2">
                            <input type="radio" name="print-mode-option" value="quiz" onchange="renderPrintPreviewCards()" class="accent-sky-600">
                            <span>空白自測考卷版（隱藏答案＋留手寫訂正框）</span>
                        </label>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="print-opt-notes" checked onchange="renderPrintPreviewCards()" class="accent-sky-600">
                        <span>附加上方「再測驗日期 / 訂正簽名欄」</span>
                    </label>
                </div>
            </div>

            <!-- Scrollable Preview Container -->
            <div id="print-preview-scroll" class="p-4 sm:p-6 overflow-y-auto space-y-6 flex-1 min-h-0 bg-slate-200/70">
                <!-- Populated by renderPrintPreviewCards() -->
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast-box" class="fixed bottom-5 right-5 z-50 hidden px-4 py-3 rounded-xl shadow-lg theme-card border-l-4 flex items-center gap-2.5 text-sm font-medium transition-all">
        <i id="toast-icon" class="fa-solid fa-circle-info"></i>
        <span id="toast-message">通知訊息</span>
    </div>

    <!-- Hidden Staging Area for Printing & Single-Question Image Export -->
    <div id="print-staging-area" class="hidden"></div>

    <script>
        // Application State
        let currentTheme = 'sky-blue';
        let currentLayout = 'auto'; // 'auto' | 'desktop' | 'mobile'
        let blindReviewMode = false;
        let printSelectionMode = false;
        let selectedQuestionIds = new Set();
        let lastFocusedInputId = 'q-content';
        let customGeminiApiKey = '';

        // Star Pickers State in Modal
        let modalDifficulty = 3;
        let modalImportance = 4;

        // Trash Bin State (Stores deleted questions with deletedAt timestamp)
        let deletedQuestions = [
            {
                id: 'q-trash-demo',
                subject: '生物',
                date: '2026-10-12',
                deletedAt: '2026-10-16 21:30',
                reason: '粗心看錯',
                difficulty: 2,
                importance: 3,
                tags: ['細胞構造', '植物細胞', '七年級上'],
                content: '下列哪一種構造被稱為「細胞的發電廠」，能進行呼吸作用產生能量供細胞使用？\n(A) 葉綠體  (B) 粒線體  (C) 液泡  (D) 細胞核',
                answer: '正確答案：(B) 粒線體\n解析：粒線體負責進行呼吸作用釋放能量；葉綠體則是進行光合作用製造養分。',
                canvasImage: null
            }
        ];

        // Math & Geometry Symbols List
        const mathSymbols = [
            '△', '∠', '⊥', '∥', '≅', '∼', '⊙', '▱', '°',
            '√', '±', '×', '÷', '≠', '≤', '≥', '≈', '∞',
            'π', '²', '³', '½', '¼', '¾', 'x', 'y',
            'α', 'β', 'θ', '∵', '∴', '⇒', '⇔'
        ];

        // Sample Junior High School Questions
        let questions = [
            {
                id: 'q-101',
                subject: '數學',
                date: '2026-10-15',
                reason: '圖形誤判',
                difficulty: 4,
                importance: 5,
                tags: ['畢氏定理', '直角三角形', '八年級上'],
                content: '已知直角 △ABC 中，∠C = 90°，若兩股長分別為 AC = 6 cm，BC = 8 cm，今由 C 點向斜邊 AB 作垂直線交於 D 點 (CD ⊥ AB)，求斜邊上的高 CD 長度為多少 cm？',
                answer: '1. 先用畢氏定理求斜邊 AB：\n   AB = √(AC² + BC²) = √(6² + 8²) = √(36 + 64) = √100 = 10 cm\n2. 利用面積相等法（兩股乘積 ÷ 2 = 斜邊 × 斜邊高 ÷ 2）：\n   (6 × 8) ÷ 2 = (10 × CD) ÷ 2\n   ∴ CD = 48 ÷ 10 = 4.8 cm',
                canvasImage: null // Will generate a neat geometry diagram on init
            },
            {
                id: 'q-102',
                subject: '理化',
                date: '2026-10-16',
                reason: '公式忘記',
                difficulty: 3,
                importance: 5,
                tags: ['牛頓第二運動定律', '直線運動', '九年級上'],
                content: '將質量 2 kg 的木塊置於光滑水平桌面上，施以 10 N 的水平定力推木塊，求木塊獲得的加速度大小為多少 m/s²？若由靜止開始推 3 秒，移動距離為多少公尺？',
                answer: '1. 由 F = m × a 得：\n   10 = 2 × a ⇒ a = 5 m/s²\n2. 由等加速度直線運動公式 S = v₀t + ½at²（初速 v₀ = 0）：\n   S = 0 + ½ × 5 × 3² = 2.5 × 9 = 22.5 公尺',
                canvasImage: null
            },
            {
                id: 'q-103',
                subject: '英文',
                date: '2026-10-17',
                reason: '觀念不清',
                difficulty: 3,
                importance: 4,
                tags: ['現在完成式', '感官動詞', '會考高頻'],
                content: 'Mr. Lin ______ in Hsinchu since he graduated from college ten years ago.\n(A) lives  (B) lived  (C) has lived  (D) is living',
                answer: '正確答案：(C) has lived\n解析：\n句中有 "since + 過去時間點 (he graduated...)"，表示動作從十年前持續到現在，主詞 Mr. Lin 為第三人稱單數，故使用現在完成式 has + Vpp (has lived)。',
                canvasImage: null
            }
        ];

        let canvas, ctx;
        let isDrawing = false;
        let currentTool = 'pen';
        let currentColor = '#ef4444';
        let startX = 0, startY = 0;
        let canvasHistory = [];
        let snapshotBeforeDrag = null;

        function initCanvas() {
            canvas = document.getElementById('annotation-canvas');
            if (!canvas) return; // Guard clause to prevent null reference errors
            ctx = canvas.getContext('2d');
            resetCanvasWhite();

            // Mouse Events
            canvas.addEventListener('mousedown', startStroke);
            canvas.addEventListener('mousemove', moveStroke);
            window.addEventListener('mouseup', endStroke);

            // Touch Events
            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                const touch = e.touches[0];
                startStroke(touch);
            }, { passive: false });
            canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                const touch = e.touches[0];
                moveStroke(touch);
            }, { passive: false });
            canvas.addEventListener('touchend', (e) => {
                e.preventDefault();
                endStroke();
            }, { passive: false });
        }

        function getCanvasCoords(e) {
            if (!canvas) return { x: 0, y: 0 };
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            return {
                x: (e.clientX - rect.left) * scaleX,
                y: (e.clientY - rect.top) * scaleY
            };
        }

        function resetCanvasWhite() {
            if (!ctx || !canvas) return;
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            // Subtle grid lines for geometry convenience
            ctx.strokeStyle = '#f1f5f9';
            ctx.lineWidth = 1;
            for (let x = 0; x < canvas.width; x += 30) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
            }
            for (let y = 0; y < canvas.height; y += 30) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
            }
            saveCanvasHistory();
        }

        function saveCanvasHistory() {
            if (!ctx || !canvas) return;
            if (canvasHistory.length > 15) canvasHistory.shift();
            canvasHistory.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
        }

        function undoCanvasStroke() {
            if (!ctx || !canvas) return;
            if (canvasHistory.length > 1) {
                canvasHistory.pop();
                const prev = canvasHistory[canvasHistory.length - 1];
                ctx.putImageData(prev, 0, 0);
            } else {
                showToast('已經是最初狀態囉！');
            }
        }

        function clearCanvas() {
            canvasHistory = [];
            resetCanvasWhite();
        }

        function setCanvasTool(tool) {
            currentTool = tool;
            document.querySelectorAll('.canvas-tool-btn').forEach(btn => {
                btn.classList.remove('theme-btn-primary');
                btn.classList.add('theme-btn-secondary');
            });
            const activeBtn = document.getElementById('tool-' + tool);
            if (activeBtn) {
                activeBtn.classList.remove('theme-btn-secondary');
                activeBtn.classList.add('theme-btn-primary');
            }
        }

        function setCanvasColor(color) {
            currentColor = color;
            if (currentTool === 'eraser') setCanvasTool('pen');
        }

        function startStroke(e) {
            isDrawing = true;
            const pos = getCanvasCoords(e);
            startX = pos.x;
            startY = pos.y;
            snapshotBeforeDrag = ctx.getImageData(0, 0, canvas.width, canvas.height);

            if (currentTool === 'pen' || currentTool === 'highlighter' || currentTool === 'eraser') {
                ctx.beginPath();
                ctx.moveTo(startX, startY);
            }
        }

        function moveStroke(e) {
            if (!isDrawing || !ctx) return;
            const pos = getCanvasCoords(e);

            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            if (currentTool === 'pen') {
                ctx.globalAlpha = 1.0;
                ctx.strokeStyle = currentColor;
                ctx.lineWidth = 3;
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
            } else if (currentTool === 'highlighter') {
                ctx.putImageData(snapshotBeforeDrag, 0, 0);
                ctx.globalAlpha = 0.35;
                ctx.strokeStyle = currentColor;
                ctx.lineWidth = 18;
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                ctx.globalAlpha = 1.0;
            } else if (currentTool === 'eraser') {
                ctx.globalAlpha = 1.0;
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 20;
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
            } else {
                // Shape preview
                ctx.putImageData(snapshotBeforeDrag, 0, 0);
                ctx.globalAlpha = 1.0;
                ctx.strokeStyle = currentColor;
                ctx.lineWidth = 2.5;
                drawGeometryShape(currentTool, startX, startY, pos.x, pos.y);
            }
        }

        function endStroke() {
            if (!isDrawing) return;
            isDrawing = false;
            if (ctx) ctx.globalAlpha = 1.0;
            saveCanvasHistory();
        }

        function drawGeometryShape(tool, x1, y1, x2, y2) {
            ctx.beginPath();
            if (tool === 'line') {
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            } else if (tool === 'rect') {
                ctx.strokeRect(x1, y1, x2 - x1, y2 - y1);
            } else if (tool === 'triangle') {
                ctx.moveTo(x1, y1);
                ctx.lineTo(x1, y2);
                ctx.lineTo(x2, y2);
                ctx.closePath();
                ctx.stroke();
                const size = 12;
                if (Math.abs(x2 - x1) > 25 && Math.abs(y2 - y1) > 25) {
                    const dirX = x2 > x1 ? 1 : -1;
                    const dirY = y1 < y2 ? -1 : 1;
                    ctx.strokeRect(x1, y2, size * dirX, size * dirY);
                }
            } else if (tool === 'circle') {
                const radius = Math.hypot(x2 - x1, y2 - y1);
                ctx.arc(x1, y1, radius, 0, Math.PI * 2);
                ctx.stroke();
                ctx.fillStyle = currentColor;
                ctx.fillRect(x1 - 2, y1 - 2, 4, 4);
            } else if (tool === 'axes') {
                const midX = (x1 + x2) / 2;
                const midY = (y1 + y2) / 2;
                ctx.moveTo(x1, midY);
                ctx.lineTo(x2, midY);
                ctx.moveTo(midX, y1);
                ctx.lineTo(midX, y2);
                ctx.stroke();
            }
        }

        function loadBackgroundImageToCanvas(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                const img = new Image();
                img.onload = function() {
                    resetCanvasWhite();
                    const scale = Math.min(canvas.width / img.width, canvas.height / img.height);
                    const w = img.width * scale;
                    const h = img.height * scale;
                    const x = (canvas.width - w) / 2;
                    const y = (canvas.height - h) / 2;
                    ctx.drawImage(img, x, y, w, h);
                    saveCanvasHistory();
                    showToast('已載入圖片！現在可以用畫筆或螢光筆在上面做標記');
                };
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        }

        function loadBackgroundImageFromDataUrl(dataUrl) {
            const img = new Image();
            img.onload = function() {
                if (!canvas || !ctx) return;
                resetCanvasWhite();
                const scale = Math.min(canvas.width / img.width, canvas.height / img.height);
                const w = img.width * scale;
                const h = img.height * scale;
                const x = (canvas.width - w) / 2;
                const y = (canvas.height - h) / 2;
                ctx.drawImage(img, x, y, w, h);
                saveCanvasHistory();
            };
            img.src = dataUrl;
        }

        function createSampleGeometryDiagram() {
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = 500;
            tempCanvas.height = 240;
            const tCtx = tempCanvas.getContext('2d');
            tCtx.fillStyle = '#ffffff';
            tCtx.fillRect(0, 0, 500, 240);

            tCtx.strokeStyle = '#1e293b';
            tCtx.lineWidth = 3;
            tCtx.beginPath();
            tCtx.moveTo(120, 40);
            tCtx.lineTo(60, 190);
            tCtx.lineTo(380, 190);
            tCtx.closePath();
            tCtx.stroke();

            tCtx.strokeStyle = '#ef4444';
            tCtx.setLineDash([6, 4]);
            tCtx.beginPath();
            tCtx.moveTo(120, 40);
            tCtx.lineTo(120, 190);
            tCtx.stroke();
            tCtx.setLineDash([]);

            tCtx.strokeRect(120, 176, 14, 14);

            tCtx.fillStyle = '#0f172a';
            tCtx.font = 'bold 16px Inter, sans-serif';
            tCtx.fillText('C (90°)', 105, 30);
            tCtx.fillText('A', 40, 198);
            tCtx.fillText('B', 392, 198);
            tCtx.fillStyle = '#ef4444';
            tCtx.fillText('D', 115, 215);
            tCtx.fillText('CD = 4.8', 132, 125);
            tCtx.fillStyle = '#2563eb';
            tCtx.fillText('6 cm', 45, 115);
            tCtx.fillText('8 cm', 250, 105);

            return tempCanvas.toDataURL('image/png');
        }

        async function scanImageToText(event, targetTextareaId) {
            const file = event.target.files[0];
            if (!file) return;

            const statusBanner = document.getElementById('ocr-status-banner');
            const statusText = document.getElementById('ocr-status-text');
            statusBanner.classList.remove('hidden');
            statusText.textContent = '正在讀取圖片並透過 AI 辨識文字與數學公式...';

            try {
                const base64Data = await fileToBase64(file);
                const mimeType = file.type || 'image/png';

                loadBackgroundImageFromDataUrl(`data:${mimeType};base64,${base64Data}`);

                const apiKey = customGeminiApiKey || "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                const prompt = "請精準辨識這張圖片中的所有繁體中文、英文與數學符號（如 △, ∠, ⊥, √, ², ± 等），直接輸出純文字內容，不要加上任何額外開場白或解釋，方便學生直接貼入錯題本。";

                const payload = {
                    contents: [{
                        role: "user",
                        parts: [
                            { text: prompt },
                            { inlineData: { mimeType: mimeType, data: base64Data } }
                        ]
                    }]
                };

                const response = await fetchWithRetry(apiUrl, payload);
                const result = await response.json();
                const extractedText = result?.candidates?.[0]?.content?.parts?.[0]?.text;

                if (extractedText) {
                    const targetEl = document.getElementById(targetTextareaId);
                    targetEl.value = (targetEl.value ? targetEl.value + '\n' : '') + extractedText.trim();
                    showToast('✨ AI 文字辨識完成！已自動填入欄位並同步載入至下方畫板');
                } else {
                    showToast('未能辨識出文字，請確認圖片清晰度或直接手動輸入');
                }
            } catch (err) {
                showToast('圖片掃描發生錯誤，已為您將圖片載入至下方畫板方便檢視');
            } finally {
                statusBanner.classList.add('hidden');
                event.target.value = '';
            }
        }

        function fileToBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => {
                    const base64String = reader.result.split(',')[1];
                    resolve(base64String);
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        async function fetchWithRetry(url, payload, retries = 3) {
            let delay = 1000;
            for (let i = 0; i < retries; i++) {
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (res.ok) return res;
                } catch (e) {}
                await new Promise(r => setTimeout(r, delay));
                delay *= 2;
            }
            throw new Error('API request failed');
        }

        function initMathButtons() {
            const container = document.getElementById('math-symbol-buttons');
            if (!container) return;
            container.innerHTML = mathSymbols.map(sym => `
                <button type="button" onclick="insertSymbol('${sym}')" class="theme-btn-secondary w-8 h-8 rounded-lg font-mono text-sm font-semibold flex items-center justify-center hover:scale-105 transition">
                    ${sym}
                </button>
            `).join('');
        }

        function setLastFocusedInput(id) {
            lastFocusedInputId = id;
        }

        function insertSymbol(sym) {
            const input = document.getElementById(lastFocusedInputId);
            if (!input) return;
            const start = input.selectionStart || input.value.length;
            const end = input.selectionEnd || input.value.length;
            const text = input.value;
            input.value = text.substring(0, start) + sym + text.substring(end);
            input.focus();
            input.selectionStart = input.selectionEnd = start + sym.length;
        }

        function renderStarPickers() {
            const diffContainer = document.getElementById('difficulty-stars-picker');
            const impContainer = document.getElementById('importance-stars-picker');
            if (!diffContainer || !impContainer) return;

            diffContainer.innerHTML = [1, 2, 3, 4, 5].map(n => `
                <button type="button" onclick="setModalStars('difficulty', ${n})" class="text-lg transition ${n <= modalDifficulty ? 'text-amber-400 scale-110' : 'text-slate-400/40'}">
                    <i class="fa-solid fa-star"></i>
                </button>
            `).join('') + `<span class="text-xs ml-auto font-mono">${modalDifficulty}/5</span>`;

            impContainer.innerHTML = [1, 2, 3, 4, 5].map(n => `
                <button type="button" onclick="setModalStars('importance', ${n})" class="text-lg transition ${n <= modalImportance ? 'text-rose-500 scale-110' : 'text-slate-400/40'}">
                    <i class="fa-solid fa-fire"></i>
                </button>
            `).join('') + `<span class="text-xs ml-auto font-mono">${modalImportance}/5</span>`;
        }

        function setModalStars(type, val) {
            if (type === 'difficulty') modalDifficulty = val;
            if (type === 'importance') modalImportance = val;
            renderStarPickers();
        }

        function renderSubjectQuickPills() {
            const subjects = ['ALL', '國文', '英文', '數學', '理化', '生物', '地科', '歷史', '地理', '公民'];
            const activeSubject = document.getElementById('filter-subject').value;
            const container = document.getElementById('subject-quick-pills');
            if (!container) return;

            container.innerHTML = subjects.map(sub => {
                const count = sub === 'ALL' ? questions.length : questions.filter(q => q.subject === sub).length;
                const isActive = activeSubject === sub;
                return `
                    <button onclick="selectQuickSubject('${sub}')" class="${isActive ? 'theme-btn-primary' : 'theme-btn-secondary'} px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap flex items-center gap-1.5 transition">
                        <span>${sub === 'ALL' ? '全部科目' : sub}</span>
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-black/15">${count}</span>
                    </button>
                `;
            }).join('');
        }

        function selectQuickSubject(sub) {
            document.getElementById('filter-subject').value = sub;
            renderQuestions();
        }

        function getFilteredQuestions() {
            const search = document.getElementById('filter-search').value.trim().toLowerCase();
            const subject = document.getElementById('filter-subject').value;
            const reason = document.getElementById('filter-reason').value;
            const sort = document.getElementById('filter-sort').value;

            let list = questions.filter(q => {
                const matchSubject = subject === 'ALL' || q.subject === subject;
                const matchReason = reason === 'ALL' || q.reason === reason;
                const matchSearch = !search ||
                    q.content.toLowerCase().includes(search) ||
                    q.answer.toLowerCase().includes(search) ||
                    q.tags.some(t => t.toLowerCase().includes(search));
                return matchSubject && matchReason && matchSearch;
            });

            list.sort((a, b) => {
                if (sort === 'importance-desc') return b.importance - a.importance;
                if (sort === 'difficulty-desc') return b.difficulty - a.difficulty;
                return b.date.localeCompare(a.date);
            });

            return list;
        }

        function renderQuestions() {
            renderSubjectQuickPills();
            const filtered = getFilteredQuestions();
            const grid = document.getElementById('questions-grid');
            if (!grid) return;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full theme-card rounded-2xl p-10 text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl mx-auto flex items-center justify-center theme-badge text-2xl">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <h3 class="text-base font-bold">目前沒有符合篩選條件的錯題</h3>
                        <p class="text-xs" style="color: var(--text-secondary);">點擊右上角「新增錯題」開始建立你的專屬國中錯題庫！</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(q => {
                const isSelected = selectedQuestionIds.has(q.id);
                const diffStars = '★'.repeat(q.difficulty) + '☆'.repeat(5 - q.difficulty);
                const impFires = '🔥'.repeat(q.importance);

                return `
                    <article id="card-${q.id}" class="theme-card rounded-2xl p-5 flex flex-col justify-between gap-4 transition relative ${isSelected ? 'ring-2 ring-amber-500' : ''}">
                        <div>
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                                <div class="flex items-center gap-2 flex-wrap">
                                    ${printSelectionMode ? `
                                        <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleSelectQuestion('${q.id}')" class="w-5 h-5 accent-amber-500 cursor-pointer rounded">
                                    ` : ''}
                                    <span class="theme-badge px-2.5 py-1 rounded-lg text-xs font-bold">${q.subject}</span>
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-rose-500/15 text-rose-500 border border-rose-500/30">
                                        <i class="fa-solid fa-triangle-exclamation mr-1"></i>${q.reason}
                                    </span>
                                </div>
                                <span class="text-xs font-mono" style="color: var(--text-secondary);">
                                    <i class="fa-regular fa-calendar mr-1"></i>${q.date}
                                </span>
                            </div>

                            <div class="flex flex-wrap items-center gap-4 text-xs mb-3 pb-2.5 border-b" style="border-color: var(--border-color);">
                                <div class="flex items-center gap-1">
                                    <span style="color: var(--text-secondary);">難度：</span>
                                    <span class="text-amber-400 tracking-tighter text-sm">${diffStars}</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span style="color: var(--text-secondary);">重要度：</span>
                                    <span class="text-xs">${impFires}</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="text-xs font-bold uppercase tracking-wider mb-1" style="color: var(--accent-primary);">【題目】</div>
                                <div class="text-sm md:text-base font-medium whitespace-pre-wrap leading-relaxed">${escapeHtml(q.content)}</div>
                            </div>

                            ${q.canvasImage ? `
                                <div class="mb-4 rounded-xl overflow-hidden border bg-white p-2 flex justify-center" style="border-color: var(--border-color);">
                                    <img src="${q.canvasImage}" alt="題目幾何與標記附圖" class="max-h-52 w-auto object-contain rounded-lg">
                                </div>
                            ` : ''}

                            <div class="p-3.5 rounded-xl border transition-all" style="background-color: var(--bg-tertiary); border-color: var(--border-color);">
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-xs font-bold flex items-center gap-1.5" style="color: var(--success-color);">
                                        <i class="fa-solid fa-lightbulb"></i>【正確答案與解題過程】
                                    </span>
                                    ${blindReviewMode ? `
                                        <button onclick="this.parentElement.nextElementSibling.classList.toggle('blur-md')" class="text-xs underline" style="color: var(--accent-primary);">點擊偷看/隱藏</button>
                                    ` : ''}
                                </div>
                                <div class="text-sm whitespace-pre-wrap leading-relaxed transition-all duration-200 ${blindReviewMode ? 'blur-md select-none' : ''}">${escapeHtml(q.answer)}</div>
                            </div>
                        </div>

                        <div class="pt-3 border-t flex flex-wrap items-center justify-between gap-2" style="border-color: var(--border-color);">
                            <div class="flex flex-wrap gap-1.5">
                                ${q.tags.map(tag => `
                                    <span class="text-[11px] px-2 py-0.5 rounded-md theme-btn-secondary">#${escapeHtml(tag)}</span>
                                `).join('')}
                            </div>
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <label class="theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1 cursor-pointer" title="直接上傳或更換這題的附圖照片">
                                    <i class="fa-solid fa-cloud-arrow-up" style="color: var(--accent-primary);"></i> 傳圖標記
                                    <input type="file" accept="image/*" class="hidden" onchange="uploadImageDirectlyToCard(event, '${q.id}')">
                                </label>
                                <button onclick="openSingleQuestionPrint('${q.id}')" class="theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="單題預覽列印或轉成高清圖卡">
                                    <i class="fa-solid fa-print"></i> 列印/轉圖
                                </button>
                                <button onclick="editQuestion('${q.id}')" class="theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs flex items-center gap-1" title="編輯與畫筆標記">
                                    <i class="fa-solid fa-pen-to-square"></i> 編輯
                                </button>
                                <button onclick="deleteQuestion('${q.id}')" class="theme-btn-secondary px-2.5 py-1.5 rounded-lg text-xs text-rose-500 hover:bg-rose-500/10" title="移至垃圾桶">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </article>
                `;
            }).join('');

            updateTrashBadgeUI();
            saveStateToLocalStorage();
        }

        function saveStateToLocalStorage() {
            try {
                localStorage.setItem('jh_mistake_questions_v2', JSON.stringify(questions));
                localStorage.setItem('jh_mistake_trash_v2', JSON.stringify(deletedQuestions));
            } catch (e) {}
        }

        function loadStateFromLocalStorage() {
            try {
                const savedQ = localStorage.getItem('jh_mistake_questions_v2');
                const savedTrash = localStorage.getItem('jh_mistake_trash_v2');
                const savedKey = localStorage.getItem('jh_mistake_api_key');
                if (savedQ) {
                    const parsedQ = JSON.parse(savedQ);
                    if (Array.isArray(parsedQ) && parsedQ.length > 0) questions = parsedQ;
                }
                if (savedTrash) {
                    const parsedT = JSON.parse(savedTrash);
                    if (Array.isArray(parsedT)) deletedQuestions = parsedT;
                }
                if (savedKey) {
                    customGeminiApiKey = savedKey;
                    const keyInput = document.getElementById('custom-api-key-input');
                    if (keyInput) keyInput.value = savedKey;
                }
            } catch (e) {}
        }

        function saveCustomApiKey(val) {
            customGeminiApiKey = val.trim();
            try {
                localStorage.setItem('jh_mistake_api_key', customGeminiApiKey);
            } catch (e) {}
            showToast('🔑 已儲存自訂 API Key 設定！');
        }

        function quickHeaderImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            resetQuestionForm();
            openModal('question-modal');
            setTimeout(() => {
                scanImageToText(event, 'q-content');
            }, 300);
        }

        function uploadImageDirectlyToCard(event, id) {
            const file = event.target.files[0];
            if (!file) return;
            editQuestion(id);
            loadBackgroundImageToCanvas(event);
            setTimeout(() => {
                const canvasBox = document.getElementById('canvas-section-box');
                if (canvasBox) canvasBox.scrollIntoView({ behavior: 'smooth' });
            }, 200);
        }

        function exportQuestionsJson() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(questions, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", `國中錯題本備份_${new Date().toISOString().split('T')[0]}.json`);
            dlAnchor.click();
            showToast('📦 已匯出錯題本備份檔！');
        }

        function importQuestionsJson(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const imported = JSON.parse(evt.target.result);
                    if (Array.isArray(imported)) {
                        questions = [...imported, ...questions];
                        renderQuestions();
                        showToast(`🎉 成功匯入 ${imported.length} 筆錯題資料！`);
                    } else {
                        showToast('檔案格式不正確，請選擇有效的錯題備份 .json 檔');
                    }
                } catch (e) {
                    showToast('讀取備份檔失敗，請確認檔案格式');
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            if (id === 'question-modal' && !document.getElementById('edit-question-id').value) {
                document.getElementById('modal-title').innerHTML = `<i class="fa-solid fa-file-circle-plus" style="color: var(--accent-primary);"></i><span>新增國中錯題記錄</span>`;
                document.getElementById('q-date').value = new Date().toISOString().split('T')[0];
                modalDifficulty = 3;
                modalImportance = 4;
                renderStarPickers();
            }
            // Ensure canvas is properly sized and initialized when modal opens
            if (id === 'question-modal') {
                setTimeout(initCanvas, 50);
            }
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if (id === 'question-modal') {
                resetQuestionForm();
            }
        }

        function resetQuestionForm() {
            document.getElementById('edit-question-id').value = '';
            document.getElementById('q-content').value = '';
            document.getElementById('q-answer').value = '';
            document.getElementById('q-tags').value = '';
            clearCanvas();
        }

        function saveQuestion() {
            const editId = document.getElementById('edit-question-id').value;
            const subject = document.getElementById('q-subject').value;
            const reason = document.getElementById('q-reason').value;
            const date = document.getElementById('q-date').value || new Date().toISOString().split('T')[0];
            let content = document.getElementById('q-content').value.trim();
            let answer = document.getElementById('q-answer').value.trim();
            const rawTags = document.getElementById('q-tags').value;

            const hasCanvasDrawing = canvasHistory.length > 1;
            const canvasDataUrl = (hasCanvasDrawing && canvas) ? canvas.toDataURL('image/png') : null;

            if (!content && !answer && !hasCanvasDrawing && !editId) {
                showToast('⚠️ 請至少輸入「題目內容」或「上傳一張題目照片/手繪圖形」再按確認喔！');
                document.getElementById('q-content').focus();
                return;
            }

            if (!content) content = '（請見下方題目附圖與標記）';
            if (!answer) answer = '（詳見附圖中的手寫訂正與標記）';

            const tags = rawTags.split(/[,，]/).map(t => t.trim()).filter(Boolean);

            if (editId) {
                const idx = questions.findIndex(q => q.id === editId);
                if (idx > -1) {
                    questions[idx] = {
                        ...questions[idx],
                        subject,
                        reason,
                        date,
                        difficulty: modalDifficulty,
                        importance: modalImportance,
                        tags: tags.length ? tags : [subject],
                        content,
                        answer,
                        canvasImage: canvasDataUrl || questions[idx].canvasImage
                    };
                }
                showToast('✅ 錯題修改已確認並儲存！');
            } else {
                questions.unshift({
                    id: 'q-' + Date.now(),
                    subject,
                    reason,
                    date,
                    difficulty: modalDifficulty,
                    importance: modalImportance,
                    tags: tags.length ? tags : [subject],
                    content,
                    answer,
                    canvasImage: canvasDataUrl
                });
                showToast('🎉 成功確認並新增一筆錯題記錄！');
            }

            closeModal('question-modal');
            renderQuestions();
        }

        function editQuestion(id) {
            const q = questions.find(item => item.id === id);
            if (!q) return;

            document.getElementById('edit-question-id').value = q.id;
            document.getElementById('modal-title').innerHTML = `<i class="fa-solid fa-pen-to-square" style="color: var(--accent-primary);"></i><span>編輯錯題與手寫標記</span>`;
            document.getElementById('q-subject').value = q.subject;
            document.getElementById('q-reason').value = q.reason;
            document.getElementById('q-date').value = q.date;
            document.getElementById('q-tags').value = q.tags.join(', ');
            document.getElementById('q-content').value = q.content;
            document.getElementById('q-answer').value = q.answer;
            modalDifficulty = q.difficulty;
            modalImportance = q.importance;
            renderStarPickers();

            document.getElementById('question-modal').classList.remove('hidden');
            setTimeout(() => {
                initCanvas();
                clearCanvas();
                if (q.canvasImage) {
                    loadBackgroundImageFromDataUrl(q.canvasImage);
                }
            }, 50);
        }

        function deleteQuestion(id) {
            const target = questions.find(q => q.id === id);
            if (!target) return;

            const now = new Date();
            const timestamp = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

            deletedQuestions.unshift({
                ...target,
                deletedAt: timestamp
            });

            questions = questions.filter(q => q.id !== id);
            selectedQuestionIds.delete(id);
            updateSelectedCountUI();
            renderQuestions();
            showToast('🗑️ 已移至「垃圾桶」！若誤刪可隨時點上方垃圾桶還原');
        }

        function updateTrashBadgeUI() {
            const badge = document.getElementById('trash-count-badge');
            if (badge) {
                badge.textContent = deletedQuestions.length;
                badge.className = deletedQuestions.length > 0
                    ? 'px-1.5 py-0.2 rounded-full text-[11px] bg-rose-500 text-white font-mono'
                    : 'px-1.5 py-0.2 rounded-full text-[11px] bg-slate-400/30 font-mono';
            }
        }

        function openTrashModal() {
            renderTrashList();
            openModal('trash-modal');
        }

        function renderTrashList() {
            const container = document.getElementById('trash-list-container');
            const restoreAllBtn = document.getElementById('btn-restore-all');
            const emptyTrashBtn = document.getElementById('btn-empty-trash');
            if (!container) return;

            if (deletedQuestions.length === 0) {
                if (restoreAllBtn) restoreAllBtn.classList.add('hidden');
                if (emptyTrashBtn) emptyTrashBtn.classList.add('hidden');
                container.innerHTML = `
                    <div class="text-center py-12 space-y-3">
                        <div class="w-14 h-14 rounded-2xl mx-auto flex items-center justify-center bg-slate-500/10 text-slate-400 text-2xl">
                            <i class="fa-solid fa-trash-can"></i>
                        </div>
                        <div class="font-bold text-base">垃圾桶目前是空的</div>
                        <p class="text-xs" style="color: var(--text-secondary);">刪除的錯題會暫存在這裡，避免不小心誤刪重要筆記</p>
                    </div>
                `;
                return;
            }

            if (restoreAllBtn) restoreAllBtn.classList.remove('hidden');
            if (emptyTrashBtn) emptyTrashBtn.classList.remove('hidden');

            container.innerHTML = deletedQuestions.map(q => `
                <div class="p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition" style="background-color: var(--bg-primary); border-color: var(--border-color);">
                    <div class="space-y-1 flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="theme-badge px-2 py-0.5 rounded text-xs font-bold">${q.subject}</span>
                            <span class="text-xs px-2 py-0.5 rounded bg-rose-500/15 text-rose-500">${q.reason}</span>
                            <span class="text-[11px] font-mono" style="color: var(--text-secondary);">
                                <i class="fa-regular fa-clock mr-1"></i>刪除時間：${q.deletedAt || q.date}
                            </span>
                        </div>
                        <div class="text-sm font-medium truncate">${escapeHtml(q.content)}</div>
                        <div class="text-xs truncate" style="color: var(--text-secondary);">解答：${escapeHtml(q.answer)}</div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button onclick="restoreFromTrash('${q.id}')" class="theme-btn-primary px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1 shadow-sm">
                            <i class="fa-solid fa-rotate-left"></i> 還原此題
                        </button>
                        <button onclick="permanentlyDeleteFromTrash('${q.id}')" class="theme-btn-secondary px-2.5 py-1.5 rounded-xl text-xs text-rose-500 hover:bg-rose-500/15" title="永久刪除無法復原">
                            <i class="fa-solid fa-xmark"></i> 永久刪除
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function restoreFromTrash(id) {
            const idx = deletedQuestions.findIndex(q => q.id === id);
            if (idx === -1) return;
            const restored = { ...deletedQuestions[idx] };
            delete restored.deletedAt;
            questions.unshift(restored);
            deletedQuestions.splice(idx, 1);
            renderTrashList();
            renderQuestions();
            showToast('♻️ 已成功將錯題還原至錯題本！');
        }

        function restoreAllFromTrash() {
            if (deletedQuestions.length === 0) return;
            const count = deletedQuestions.length;
            const restoredItems = deletedQuestions.map(q => {
                const copy = { ...q };
                delete copy.deletedAt;
                return copy;
            });
            questions = [...restoredItems, ...questions];
            deletedQuestions = [];
            renderTrashList();
            renderQuestions();
            showToast(`♻️ 已將全部 ${count} 筆錯題還原至錯題本！`);
        }

        function permanentlyDeleteFromTrash(id) {
            deletedQuestions = deletedQuestions.filter(q => q.id !== id);
            renderTrashList();
            updateTrashBadgeUI();
            saveStateToLocalStorage();
            showToast('已從垃圾桶永久移除該題');
        }

        function emptyTrashBin() {
            if (deletedQuestions.length === 0) return;
            deletedQuestions = [];
            renderTrashList();
            updateTrashBadgeUI();
            saveStateToLocalStorage();
            showToast('🧹 已清空垃圾桶所有錯題');
        }

        function toggleBlindReviewMode() {
            blindReviewMode = !blindReviewMode;
            const btn = document.getElementById('btn-blind-review');
            if (blindReviewMode) {
                btn.classList.remove('theme-btn-secondary');
                btn.classList.add('theme-btn-primary');
                btn.innerHTML = `<i class="fa-solid fa-eye"></i><span>顯示全部答案</span>`;
                showToast('已開啟「遮蔽答案自測模式」，點擊卡片上的按鈕可單獨偷看答案！');
            } else {
                btn.classList.remove('theme-btn-primary');
                btn.classList.add('theme-btn-secondary');
                btn.innerHTML = `<i class="fa-solid fa-eye-slash"></i><span>遮蔽答案自測</span>`;
            }
            renderQuestions();
        }

        function setTheme(themeName) {
            currentTheme = themeName;
            if (themeName === 'sky-blue') {
                document.documentElement.removeAttribute('data-theme');
            } else {
                document.documentElement.setAttribute('data-theme', themeName);
            }

            document.querySelectorAll('.theme-check').forEach(el => el.classList.add('hidden'));
            const activeBtn = document.getElementById('theme-btn-' + themeName);
            if (activeBtn) {
                const checkIcon = activeBtn.querySelector('.theme-check');
                if (checkIcon) checkIcon.classList.remove('hidden');
            }
            showToast('已切換主題風格！');
        }

        function setDeviceLayout(mode) {
            currentLayout = mode;
            const wrapper = document.getElementById('app-wrapper');
            const grid = document.getElementById('questions-grid');
            const indicator = document.getElementById('device-mode-indicator');

            ['auto', 'desktop', 'mobile'].forEach(m => {
                const btn = document.getElementById('layout-btn-' + m);
                if (btn) {
                    btn.classList.remove('theme-btn-primary');
                    btn.classList.add('theme-btn-secondary');
                }
            });
            const activeLayoutBtn = document.getElementById('layout-btn-' + mode);
            if (activeLayoutBtn) {
                activeLayoutBtn.classList.remove('theme-btn-secondary');
                activeLayoutBtn.classList.add('theme-btn-primary');
            }

            if (mode === 'mobile') {
                if (wrapper) wrapper.classList.add('viewport-mobile-frame');
                if (grid) grid.className = 'grid grid-cols-1 gap-4';
                if (indicator) indicator.textContent = '📱 手機單欄模式';
            } else if (mode === 'desktop') {
                if (wrapper) wrapper.classList.remove('viewport-mobile-frame');
                if (grid) grid.className = 'grid grid-cols-2 gap-5';
                if (indicator) indicator.textContent = '🖥️ 電腦雙欄模式';
            } else {
                if (wrapper) wrapper.classList.remove('viewport-mobile-frame');
                if (grid) grid.className = 'grid grid-cols-1 md:grid-cols-2 gap-5';
                if (indicator) indicator.textContent = '自動響應';
            }
        }

        function togglePrintSelectionMode() {
            printSelectionMode = !printSelectionMode;
            const bar = document.getElementById('print-action-bar');
            if (printSelectionMode) {
                if (bar) bar.classList.remove('hidden');
                getFilteredQuestions().forEach(q => selectedQuestionIds.add(q.id));
            } else {
                if (bar) bar.classList.add('hidden');
                selectedQuestionIds.clear();
            }
            updateSelectedCountUI();
            renderQuestions();
        }

        function toggleSelectQuestion(id) {
            if (selectedQuestionIds.has(id)) {
                selectedQuestionIds.delete(id);
            } else {
                selectedQuestionIds.add(id);
            }
            updateSelectedCountUI();
            renderQuestions();
        }

        function selectAllVisibleQuestions() {
            getFilteredQuestions().forEach(q => selectedQuestionIds.add(q.id));
            updateSelectedCountUI();
            renderQuestions();
        }

        function clearSelectedQuestions() {
            selectedQuestionIds.clear();
            updateSelectedCountUI();
            renderQuestions();
        }

        function updateSelectedCountUI() {
            const countEl = document.getElementById('selected-count');
            if (countEl) countEl.textContent = selectedQuestionIds.size;
        }

        function openSingleQuestionPrint(id) {
            selectedQuestionIds.clear();
            selectedQuestionIds.add(id);
            updateSelectedCountUI();
            openPrintPreviewModal();
        }

        function openPrintPreviewModal() {
            if (selectedQuestionIds.size === 0) {
                showToast('⚠️ 請至少勾選一題要列印或轉圖的錯題！');
                return;
            }
            const totalCountEl = document.getElementById('preview-total-count');
            if (totalCountEl) totalCountEl.textContent = selectedQuestionIds.size;
            renderPrintPreviewCards();
            openModal('print-preview-modal');
        }

        function buildPrintableCardHTML(q, idx, total, mode, showHeaderMeta) {
            const isQuiz = mode === 'quiz';
            const diffStars = '★'.repeat(q.difficulty) + '☆'.repeat(5 - q.difficulty);
            const impStars = '★'.repeat(q.importance) + '☆'.repeat(5 - q.importance);

            return `
                <div class="print-page-card bg-white text-slate-900 rounded-xl border-2 border-slate-800 p-6 shadow-md max-w-[760px] mx-auto" data-print-card-id="${q.id}">
                    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; border-bottom:2px solid #1e293b; padding-bottom:12px; margin-bottom:16px; gap:8px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="background:#0284c7; color:#ffffff; font-weight:800; padding:4px 12px; border-radius:6px; font-size:15px;">
                                ${escapeHtml(q.subject)}
                            </span>
                            <span style="font-size:17px; font-weight:800; color:#0f172a;">
                                國中錯題專屬卡 (${idx + 1} / ${total})
                            </span>
                            <span style="background:#ffe4e6; color:#e11d48; border:1px solid #fecdd3; font-size:12px; font-weight:700; padding:2px 8px; border-radius:6px;">
                                易錯因：${escapeHtml(q.reason)}
                            </span>
                        </div>
                        <div style="font-size:12px; color:#475569; font-family:monospace;">
                            記錄日期：${q.date} ｜ 難度：${diffStars} ｜ 重要度：${impStars}
                        </div>
                    </div>

                    ${showHeaderMeta ? `
                        <div style="display:flex; justify-content:space-between; background:#f8fafc; border:1px dashed #94a3b8; padding:8px 14px; border-radius:8px; margin-bottom:16px; font-size:12px; color:#334155;">
                            <span>📅 複習日期：____年____月____日</span>
                            <span>✅ 自我檢測：□ 已完全精通　□ 需再複習一次</span>
                            <span>✍️ 訂正簽名：____________</span>
                        </div>
                    ` : ''}

                    <div style="margin-bottom:18px;">
                        <div style="font-weight:800; color:#0284c7; font-size:14px; margin-bottom:8px;">
                            ■ 【題目內容】
                        </div>
                        <div style="font-size:15px; line-height:1.75; color:#0f172a; white-space:pre-wrap; padding-left:4px;">${escapeHtml(q.content)}</div>
                    </div>

                    ${q.canvasImage ? `
                        <div style="margin-bottom:18px; text-align:center; border:1px solid #cbd5e1; padding:12px; border-radius:10px; background:#ffffff;">
                            <img src="${q.canvasImage}" style="max-height:260px; width:auto; margin:0 auto; display:block;" alt="題目附圖">
                        </div>
                    ` : ''}

                    ${isQuiz ? `
                        <div style="border:2px dashed #64748b; padding:16px; border-radius:10px; min-height:180px; background:#fcfcfd;">
                            <div style="font-weight:800; color:#475569; font-size:13px; margin-bottom:8px;">
                                ✏️ 【自我重算與訂正手寫區】（答案已隱藏，請在此推導過程）
                            </div>
                        </div>
                    ` : `
                        <div style="background:#f0fdf4; border:1.5px solid #86efac; padding:16px; border-radius:10px;">
                            <div style="font-weight:800; color:#15803d; font-size:14px; margin-bottom:8px;">
                                💡 【正確答案與解題過程】
                            </div>
                            <div style="font-size:14px; line-height:1.75; color:#0f172a; white-space:pre-wrap;">${escapeHtml(q.answer)}</div>
                        </div>
                    `}

                    <div style="margin-top:14px; padding-top:10px; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; font-size:11px; color:#64748b;">
                        <div>章節標籤：${q.tags.map(t => '#' + escapeHtml(t)).join('  ')}</div>
                        <div>全能國中線上錯題本 · 單題獨立圖卡</div>
                    </div>
                </div>
            `;
        }

        function renderPrintPreviewCards() {
            const selectedList = questions.filter(q => selectedQuestionIds.has(q.id));
            const modeRadio = document.querySelector('input[name="print-mode-option"]:checked');
            const mode = modeRadio ? modeRadio.value : 'study';
            const showHeaderMeta = document.getElementById('print-opt-notes')?.checked ?? true;

            const htmlContent = selectedList.map((q, idx) =>
                buildPrintableCardHTML(q, idx, selectedList.length, mode, showHeaderMeta)
            ).join('');

            const scrollEl = document.getElementById('print-preview-scroll');
            const stagingEl = document.getElementById('print-staging-area');
            if (scrollEl) scrollEl.innerHTML = htmlContent;
            if (stagingEl) stagingEl.innerHTML = htmlContent;
        }

        function triggerBrowserPrint() {
            renderPrintPreviewCards();
            window.print();
        }

        async function exportPreviewCardsAsImages() {
            const container = document.getElementById('print-preview-scroll');
            if (!container) return;
            const cardEls = container.querySelectorAll('.print-page-card');
            if (cardEls.length === 0) return;

            showToast(`📸 正在將 ${cardEls.length} 道題目轉為獨立高清圖卡...`);
            for (let i = 0; i < cardEls.length; i++) {
                const el = cardEls[i];
                const qId = el.getAttribute('data-print-card-id') || (i + 1);
                try {
                    const canvasImg = await html2canvas(el, {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff'
                    });
                    const link = document.createElement('a');
                    link.download = `國中錯題卡_${i + 1}_${qId}.png`;
                    link.href = canvasImg.toDataURL('image/png');
                    link.click();
                    await new Promise(r => setTimeout(r, 350));
                } catch (e) {}
            }
            showToast('✅ 全部單題圖片已下載完成！');
        }

        async function exportSelectedAsImages() {
            if (selectedQuestionIds.size === 0) {
                showToast('請先勾選要匯出成圖片的錯題！');
                return;
            }
            openPrintPreviewModal();
            setTimeout(() => {
                exportPreviewCardsAsImages();
            }, 300);
        }

        function showToast(msg) {
            const box = document.getElementById('toast-box');
            const text = document.getElementById('toast-message');
            if (!box || !text) return;
            text.textContent = msg;
            box.style.borderLeftColor = 'var(--accent-primary)';
            box.classList.remove('hidden');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                box.classList.add('hidden');
            }, 3500);
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // Initialize on Window Load
        window.onload = function() {
            initMathButtons();
            renderStarPickers();
            questions[0].canvasImage = createSampleGeometryDiagram();
            loadStateFromLocalStorage();
            setTheme('sky-blue');
            setDeviceLayout('auto');
            renderQuestions();
        };
    </script>
</body>
</html>
